{
  "stage": 2,
  "schema": "entity-matrix.v1",
  "entities": [
    {"entity": "campaign", "sourceTypes": ["implicit Greyholm", "UserCampaignData", "CampaignModule"], "universalDiscriminant": "campaign", "requiredFields": ["campaignId", "title", "kind", "schemaVersion"], "optionalFields": ["description", "source", "capabilities"], "references": ["worldId", "mapIds"], "visibility": "registry visibility", "runtimeState": "active/open/dirty", "cardProjection": true, "mapProjection": false, "exportRepresentation": "CampaignSnapshot.metadata"},
    {"entity": "map", "sourceTypes": ["WorldMap", "Campaign baseMapId/mapIds", "BattleMapManifestEntry"], "universalDiscriminant": "map", "requiredFields": ["id", "campaignId", "title", "coordinateSpace"], "optionalFields": ["timelineId", "backgroundImageSrc", "parentMapId", "dimensions"], "references": ["parentMapId", "timelineId"], "visibility": "public/playerVisible/dmOnly", "runtimeState": "camera and activeMapId", "cardProjection": false, "mapProjection": true, "exportRepresentation": "durable.maps"},
    {"entity": "mapLayer", "sourceTypes": ["layerPresets", "workspace layer visibility"], "universalDiscriminant": "mapLayer", "requiredFields": ["id", "mapId", "kind"], "optionalFields": ["label", "enabled"], "references": ["mapId"], "visibility": "layer visibility", "runtimeState": "UI layer toggles", "cardProjection": false, "mapProjection": true, "exportRepresentation": "durable.maps.layers/runtime.ui"},
    {"entity": "hotspot", "sourceTypes": ["MapHotspot"], "universalDiscriminant": "hotspot", "requiredFields": ["id", "mapId", "position"], "optionalFields": ["locationRef", "timelineId", "label"], "references": ["mapId", "locationStateId"], "visibility": "visibleToPlayers/status", "runtimeState": "drag/edit only", "cardProjection": false, "mapProjection": true, "exportRepresentation": "durable.maps.hotspots"},
    {"entity": "placement", "sourceTypes": ["MapObjectPlacement", "CampaignMapPlacement"], "universalDiscriminant": "placement", "requiredFields": ["id", "mapId", "entityRef", "position"], "optionalFields": ["title", "subtitle", "status", "source"], "references": ["mapId", "entityRef"], "visibility": "visibleInPlayerView/visibleToPlayers/status", "runtimeState": "selection/drag only", "cardProjection": false, "mapProjection": true, "exportRepresentation": "durable.maps.placements"},
    {"entity": "route", "sourceTypes": ["MapRoute", "CampaignRoute"], "universalDiscriminant": "route", "requiredFields": ["id", "mapId", "points"], "optionalFields": ["fromHotspotId", "toHotspotId", "travelTime", "routeType"], "references": ["mapId", "hotspot refs"], "visibility": "visibleToPlayers", "runtimeState": "partyRouteProgress", "cardProjection": false, "mapProjection": true, "exportRepresentation": "durable.routes"},
    {"entity": "travelEvent", "sourceTypes": ["TravelEvent"], "universalDiscriminant": "travelEvent", "requiredFields": ["id", "title"], "optionalFields": ["routeType", "timelineId", "effects"], "references": ["routeId", "timelineId"], "visibility": "dmOnly/playerSafe", "runtimeState": "triggered/consumed", "cardProjection": true, "mapProjection": false, "exportRepresentation": "durable.travel.events"},
    {"entity": "location", "sourceTypes": ["DmLocation", "LocationState", "CampaignLocation"], "universalDiscriminant": "location", "requiredFields": ["id", "title"], "optionalFields": ["description", "dmNotes", "playerSafeDescription", "imageRefs", "sourceLocationState"], "references": ["npcIds", "questIds", "imageIds", "parentLocationId"], "visibility": "field-level and reveal", "runtimeState": "status/visited/known/revealed/notes", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.entities.locations + runtime.locationState"},
    {"entity": "npc", "sourceTypes": ["DmNpc", "CampaignNpc"], "universalDiscriminant": "npc", "requiredFields": ["id", "name"], "optionalFields": ["role", "description", "dmNotes", "imageRef", "factionRefs"], "references": ["locationRef", "imageRef", "factionRefs"], "visibility": "visibleToPlayers/playerSafe fields", "runtimeState": "movable marker, reveal", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.entities.npcs"},
    {"entity": "player", "sourceTypes": ["DmPlayer", "CampaignPlayer"], "universalDiscriminant": "player", "requiredFields": ["id", "name"], "optionalFields": ["sheet", "stats", "inventory", "publicNotes", "dmNotes"], "references": ["imageRef"], "visibility": "player editable public fields vs dmOnly fields", "runtimeState": "hp/conditions/movable split", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.entities.players + runtime.playerState"},
    {"entity": "enemy", "sourceTypes": ["DmCustomEnemy", "CampaignEnemy"], "universalDiscriminant": "enemy", "requiredFields": ["id", "name"], "optionalFields": ["ac", "hp", "cr", "tactics", "imageRef"], "references": ["locationRefs", "questRefs", "imageRef"], "visibility": "dmOnly unless revealed/placed", "runtimeState": "battle token source", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.entities.enemies"},
    {"entity": "quest", "sourceTypes": ["DmQuest", "CampaignQuest"], "universalDiscriminant": "quest", "requiredFields": ["id", "title"], "optionalFields": ["description", "goal", "dmNotes", "status"], "references": ["locationRefs", "npcRefs", "enemyRefs", "imageRef"], "visibility": "status hidden and field-level player safe", "runtimeState": "quest status override", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.entities.quests + runtime.questStatus"},
    {"entity": "faction", "sourceTypes": ["DmFaction", "CampaignFaction"], "universalDiscriminant": "faction", "requiredFields": ["id", "name"], "optionalFields": ["role", "attitude", "description", "imageRef"], "references": ["npcRefs", "zoneRefs"], "visibility": "public/playerSafe/dmOnly", "runtimeState": "faction zone status", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.entities.factions"},
    {"entity": "image", "sourceTypes": ["DmImageItem", "CampaignImage"], "universalDiscriminant": "image", "requiredFields": ["id", "title", "src"], "optionalFields": ["relatedEntity", "tags", "playerSafe"], "references": ["entityRefs", "locationRefs"], "visibility": "safeForPlayers/playerSafe", "runtimeState": "none", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.assets.images"},
    {"entity": "shop", "sourceTypes": ["DmShop"], "universalDiscriminant": "shop", "requiredFields": ["id", "name"], "optionalFields": ["services", "items", "ownerNpcId", "image"], "references": ["locationRefs", "npcRefs", "economyItemRefs"], "visibility": "service field-level", "runtimeState": "patches", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.services.shops"},
    {"entity": "tavern", "sourceTypes": ["DmTavern"], "universalDiscriminant": "tavern", "requiredFields": ["id", "name"], "optionalFields": ["ownerNpcId", "staffNpcIds", "rooms", "rumors", "imageOverrideId"], "references": ["locationRefs", "npcRefs", "imageRef"], "visibility": "service field-level", "runtimeState": "patches", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.services.taverns"},
    {"entity": "campaignEvent", "sourceTypes": ["CampaignEvent"], "universalDiscriminant": "campaignEvent", "requiredFields": ["id", "timelineId", "name", "type", "status"], "optionalFields": ["date", "timeOfDay", "linkedRefs"], "references": ["timelineId", "locationRefs", "entityRefs"], "visibility": "visibleInPlayerView", "runtimeState": "status transitions", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.timeline.events"},
    {"entity": "delayedTrigger", "sourceTypes": ["DelayedTrigger"], "universalDiscriminant": "delayedTrigger", "requiredFields": ["id", "timelineId", "triggerType", "effect", "status"], "optionalFields": ["date", "routeId", "zoneId", "linkedLocationStateId"], "references": ["timelineId", "routeRef", "zoneRef", "locationRef"], "visibility": "dmOnly by default", "runtimeState": "armed/triggered/resolved", "cardProjection": true, "mapProjection": false, "exportRepresentation": "durable.timeline.triggers"},
    {"entity": "battleMap", "sourceTypes": ["BattleMapManifestEntry", "CampaignCustomBattleMap"], "universalDiscriminant": "battleMap", "requiredFields": ["id", "title", "variants"], "optionalFields": ["grid", "source", "externalVttUrl"], "references": ["assetRefs", "locationRefs"], "visibility": "dmOnly/player battle presentation", "runtimeState": "battle board active map", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.battles.maps"},
    {"entity": "battleEntry", "sourceTypes": ["BattleEntry"], "universalDiscriminant": "battleEntry", "requiredFields": ["id", "title", "status"], "optionalFields": ["mapRef", "participants", "position", "consequences"], "references": ["battleMapRef", "locationRef", "entityRefs"], "visibility": "visibleInPlayerView/status", "runtimeState": "active/completed", "cardProjection": true, "mapProjection": true, "exportRepresentation": "durable.battles.entries"},
    {"entity": "battleBoard", "sourceTypes": ["CampaignBattleBoard", "ActiveBattleState"], "universalDiscriminant": "battleBoard", "requiredFields": ["id", "campaignId", "battleMapRef"], "optionalFields": ["tokens", "grid", "terrain", "round", "turn"], "references": ["battleMapRef", "token source refs"], "visibility": "presentedBattle/player board", "runtimeState": "full battle runtime", "cardProjection": false, "mapProjection": false, "exportRepresentation": "runtime.battles.boards"},
    {"entity": "movableEntity", "sourceTypes": ["MovableEntity"], "universalDiscriminant": "movableEntity", "requiredFields": ["id", "mapId", "entityType", "position"], "optionalFields": ["movementState", "routeId", "sourceEntityId"], "references": ["mapId", "entityRef", "routeRef"], "visibility": "visibleInPlayerView/status", "runtimeState": "movement/position", "cardProjection": true, "mapProjection": true, "exportRepresentation": "runtime.map.movableEntities"}
  ]
}
