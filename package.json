{
  "name": "campaign-timeline-vtt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5175",
    "dev:open": "vite --host 0.0.0.0 --port 5175 --open",
    "dev:host": "vite --host 0.0.0.0 --open",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:hooks": "eslint . --format json | node scripts/check-hooks-lint.mjs",
    "lint:runtime": "npm run lint:hooks && npm run typecheck && npm run build",
    "audit:data": "node scripts/audit-campaign-data.mjs",
    "build:production-reference-manifest": "node scripts/final-cutover/build-production-reference-manifest.mjs",
    "verify:referential-integrity": "node scripts/final-cutover/verify-referential-integrity.mjs",
    "build:greyholm-runtime-shape": "npx tsx scripts/final-cutover/build-greyholm-runtime-shape.ts",
    "verify:final-migration": "npx tsx scripts/final-cutover/run-final-migration.ts",
    "verify:domain": "node scripts/verify-universal-domain.mjs",
    "verify:block-i-configuration": "npx tsx scripts/final-cutover/verify-block-i-configuration.ts",
    "verify:no-legacy-battle-write": "node scripts/final-cutover/verify-no-legacy-battle-write.mjs",
    "verify:no-legacy-field-write": "node scripts/final-cutover/verify-no-legacy-field-write.mjs",
    "verify:no-legacy-presentedcard-write": "node scripts/final-cutover/verify-no-legacy-presentedcard-write.mjs",
    "verify:no-legacy-reveal-write": "node scripts/final-cutover/verify-no-legacy-reveal-write.mjs",
    "verify:no-legacy-party-position-write": "node scripts/final-cutover/verify-no-legacy-party-position-write.mjs",
    "verify:no-legacy-map-placements-write": "node scripts/final-cutover/verify-no-legacy-map-placements-write.mjs",
    "verify:no-legacy-routes-write": "node scripts/final-cutover/verify-no-legacy-routes-write.mjs",
    "verify:no-legacy-zones-write": "node scripts/final-cutover/verify-no-legacy-zones-write.mjs",
    "verify:no-legacy-arcs-write": "node scripts/final-cutover/verify-no-legacy-arcs-write.mjs",
    "verify:no-legacy-capabilities-write": "node scripts/final-cutover/verify-no-legacy-capabilities-write.mjs",
    "verify:no-legacy-calendar-write": "node scripts/final-cutover/verify-no-legacy-calendar-write.mjs",
    "verify:no-legacy-service-write": "node scripts/final-cutover/verify-no-legacy-service-write.mjs",
    "verify:camera-not-exported": "node scripts/final-cutover/verify-camera-not-exported.mjs",
    "verify:no-legacy-registry-write": "node scripts/final-cutover/verify-no-legacy-registry-write.mjs",
    "verify:universal-campaign-registry": "node scripts/final-cutover/verify-universal-campaign-registry.mjs",
    "verify:route-resolution-uses-registry": "node scripts/final-cutover/verify-route-resolution-uses-registry.mjs",
    "verify:no-workspace-split": "node scripts/final-cutover/verify-no-workspace-split.mjs",
    "verify:no-legacy-relations-write": "node scripts/final-cutover/verify-no-legacy-relations-write.mjs",
    "verify:general-relations-authority": "node scripts/final-cutover/verify-general-relations-authority.mjs",
    "verify:no-dead-module-reintroduction": "node scripts/final-cutover/verify-no-dead-module-reintroduction.mjs",
    "verify:stage04": "node scripts/verify-stage-04-parity.mjs",
    "verify:stage05": "node scripts/verify-stage-05-projections.mjs",
    "verify:stage06": "node scripts/verify-stage-06-repository.mjs",
    "verify:stage07": "node scripts/verify-stage-07-migration.mjs",
    "verify:stage09": "node scripts/stage09/build-domain.mjs && node scripts/stage09/runShadow.mjs",
    "verify:stage10": "node scripts/stage10/build-domain.mjs && node scripts/stage10/runReadPath.mjs",
    "verify:stage11": "node scripts/stage11/build-domain.mjs && node scripts/stage11/runSections.mjs",
    "verify:stage12": "node scripts/stage12/build-domain.mjs && node scripts/stage12/runWorkspace.mjs",
    "verify:stage13": "node scripts/stage13/build-domain.mjs && node scripts/stage13/runCommandShadow.mjs",
    "verify:stage14": "node scripts/stage14/build-domain.mjs && node scripts/stage14/runAuthority.mjs",
    "verify:stage08": "node scripts/stage08/build-domain.mjs && node scripts/stage08/runParity.mjs",
    "verify:stage08d": "node scripts/stage08/build-domain.mjs && node scripts/stage08/runGreyholmOverlay.mjs",
    "verify:stage15": "node scripts/stage15/build-domain.mjs && node scripts/stage15/runDurable.mjs",
    "verify:stage16": "node scripts/stage16/build-domain.mjs && node scripts/stage16/runComplex.mjs",
    "verify:stage16-1": "node scripts/stage16-1/build-domain.mjs && node scripts/stage16-1/runIntegration.mjs",
    "verify:stage17": "node scripts/stage17/build-domain.mjs && node scripts/stage17/run.mjs",
    "verify:universal-regression": "node scripts/verify-universal-regression.mjs",
    "snapshot:promote": "node scripts/promote-overlay-snapshot.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5175 --open",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-4173}"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
